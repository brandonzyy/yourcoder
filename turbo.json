{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "YC_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "YC_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:smoke": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "yourcoder#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
